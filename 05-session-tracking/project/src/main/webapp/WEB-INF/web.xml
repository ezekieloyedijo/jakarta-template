<?xml version="1.0" encoding="UTF-8"?>
<!--
  The servlets register themselves with @WebServlet (topic 05 onward),
  so this file only holds settings that have no annotation.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>School Shop</display-name>

    <!-- A cart is forgotten after 30 minutes with no clicks -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
