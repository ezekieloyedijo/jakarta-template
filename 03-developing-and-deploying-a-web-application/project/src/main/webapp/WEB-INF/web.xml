<?xml version="1.0" encoding="UTF-8"?>
<!--
  MY PORTFOLIO: deployment descriptor.
  Change the context-param values below to YOUR details, then restart the app.
  Every page reads them, so you never hard-code your name in Java.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>My Portfolio</display-name>

    <!-- ===== Settings (read with getServletContext().getInitParameter) ===== -->
    <context-param>
        <param-name>ownerName</param-name>
        <param-value>Ada Okafor</param-value>
    </context-param>
    <context-param>
        <param-name>ownerTitle</param-name>
        <param-value>Student Java Web Developer</param-value>
    </context-param>
    <context-param>
        <param-name>ownerEmail</param-name>
        <param-value>ada@example.com</param-value>
    </context-param>

    <!-- ===== The servlets: <servlet> = WHO (nickname + class), <servlet-mapping> = WHERE (URL) ===== -->
    <servlet>
        <servlet-name>home</servlet-name>
        <servlet-class>com.school.project.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>home</servlet-name>
        <!-- an EMPTY pattern means exactly the root of the app: http://localhost:8080/ -->
        <url-pattern></url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>about</servlet-name>
        <servlet-class>com.school.project.AboutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>about</servlet-name>
        <url-pattern>/about</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>projects</servlet-name>
        <servlet-class>com.school.project.ProjectsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>projects</servlet-name>
        <url-pattern>/projects</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>contact</servlet-name>
        <servlet-class>com.school.project.ContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contact</servlet-name>
        <url-pattern>/contact</url-pattern>
    </servlet-mapping>

    <!-- ===== Friendly error pages ===== -->
    <error-page>
        <error-code>404</error-code>
        <location>/errors/404.html</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/errors/500.html</location>
    </error-page>
</web-app>
