<?xml version="1.0" encoding="UTF-8"?>
<!--
  THE DEPLOYMENT DESCRIPTOR: the app's instruction sheet for the container.
  It lives in WEB-INF, so browsers can never read it.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Topic 03 - Deployment Tour</display-name>

    <!-- (a) WELCOME FILES: what to show for "/". We chose home.html, NOT index.html -->
    <welcome-file-list>
        <welcome-file>home.html</welcome-file>
    </welcome-file-list>

    <!-- (b) A SERVLET REGISTERED THE CLASSIC WAY. Part 1 = WHO (nickname + class) -->
    <servlet>
        <servlet-name>classic</servlet-name>
        <servlet-class>com.school.example.ClassicServlet</servlet-class>
    </servlet>
    <!-- Part 2 = WHERE (which URL goes to that nickname) -->
    <servlet-mapping>
        <servlet-name>classic</servlet-name>
        <url-pattern>/classic</url-pattern>
    </servlet-mapping>

    <!-- (c) APP-WIDE SETTINGS your code can read with getServletContext().getInitParameter("...") -->
    <context-param>
        <param-name>schoolName</param-name>
        <param-value>Bright Future Academy</param-value>
    </context-param>
    <context-param>
        <param-name>appVersion</param-name>
        <param-value>1.0.0</param-value>
    </context-param>

    <!-- (d) FRIENDLY ERROR PAGES instead of the server's default ones -->
    <error-page>
        <error-code>404</error-code>
        <location>/errors/404.html</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/errors/500.html</location>
    </error-page>
</web-app>
